{
    "name": "monopoly-backend",
    "version": "1.0.0",
    "description": "Backend server for Monopoly Multiplayer Game",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon src/server.ts",
        "build": "tsc && npm run build:frontend",
        "build:frontend": "cd .. && npm run build",
        "start": "node dist/server.js",
        "lint": "eslint src --ext .ts"
    },
    "keywords": [
        "monopoly",
        "multiplayer",
        "socket.io",
        "game"
    ],
    "author": "",
    "license": "ISC",
    "dependencies": {
        "express": "^4.18.2",
        "socket.io": "^4.6.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.6",
        "@types/cors": "^2.8.17",
        "typescript": "^5.3.3",
        "nodemon": "^3.0.2",
        "ts-node": "^10.9.2"
    }
}